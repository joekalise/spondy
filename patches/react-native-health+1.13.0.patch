+const { TurboModuleRegistry } = require('react-native')
+const AppleHealthKit = TurboModuleRegistry.getEnforcing('AppleHealthKit')
+
+// Under the New Architecture, AppleHealthKit is a HostObject/TurboModule whose
+// methods resolve lazily via property access, not as enumerable own properties —
+// Object.assign({}, AppleHealthKit, {...}) silently drops every real method and
+// keeps only what's explicitly listed, leaving just Constants. Attach Constants
+// directly onto the real module object instead of copying into a plain object.
+AppleHealthKit.Constants = {
+  Activities,
+  Observers,
+  Permissions,
+  Units,
+}
+
+export const HealthKit = AppleHealthKit
 
